# ==============================================================================
# Razorpay In-Chat Agentic Commerce Engine (RAC Engine)
# Environment Configuration Template
# ==============================================================================

# LLM / OpenAI API Key (Required for semantic inference & agent orchestration)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Razorpay API Credentials (Obtain from Razorpay Dashboard -> Settings -> API Keys)
# For testing, use Sandbox keys starting with rzp_test_
RAZORPAY_KEY_ID="rzp_test_RAC991204DEMO"
RAZORPAY_KEY_SECRET="RAC_SecretKey_991204_DemoMode"
RAZORPAY_WEBHOOK_SECRET="rac_webhook_secret_hmac_2026"
RAZORPAY_CURRENCY="INR"

# Redis Session Memory Cache
REDIS_URL="redis://localhost:6379/0"

# Application Endpoints
BACKEND_URL="http://localhost:8000"
STREAMLIT_URL="http://localhost:8501"
PAYMENT_CALLBACK_URL="http://localhost:8501/?payment_status=success"

# Server Host and Port
HOST="0.0.0.0"
PORT="8000"
DEBUG="True"
